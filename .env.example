# ---------- App ----------
APP_NAME=Task Management API
DEBUG=false
BACKEND_PORT=8000
CORS_ORIGINS=*

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasks
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tasks
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tasks_test
TEST_REDIS_URL=redis://redis:6379/15

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_ACTIVE_TASKS_PER_USER=10
COMMENT_RATE_LIMIT=5
COMMENT_RATE_PERIOD_SECONDS=60
SLOW_REQUEST_THRESHOLD_MS=500

QUOTES_API_URL=https://dummyjson.com/quotes/random
QUOTES_API_TIMEOUT_SECONDS=5
